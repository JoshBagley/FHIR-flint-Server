{
  "realm": "fhir",
  "enabled": true,
  "displayName": "Flint FHIR",
  "displayNameHtml": "<b>Flint</b>",
  "loginTheme": "flint",
  "accessTokenLifespan": 3600,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "fhir-patient",
        "description": "Patient portal user \u00e2\u20ac\u201d patient-scoped FHIR access only"
      },
      {
        "name": "fhir-clinician",
        "description": "Clinician \u00e2\u20ac\u201d user-scoped FHIR access"
      },
      {
        "name": "fhir-admin",
        "description": "Admin \u00e2\u20ac\u201d system-scoped FHIR access"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "fhirUser",
      "description": "Access the current user as a FHIR Patient or Practitioner resource",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Identify you as a FHIR user"
      }
    },
    {
      "name": "launch/patient",
      "description": "Launch in the context of a specific patient",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Launch in patient context"
      }
    },
    {
      "name": "launch/encounter",
      "description": "Launch in the context of a specific encounter",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Launch in encounter context"
      }
    },
    {
      "name": "patient/*.read",
      "description": "Read all FHIR resources for the patient in context",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your clinical records"
      }
    },
    {
      "name": "patient/*.write",
      "description": "Write all FHIR resources for the patient in context",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Update your clinical records"
      }
    },
    {
      "name": "patient/*.*",
      "description": "Read and write all FHIR resources for the patient in context",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Full access to your clinical records"
      }
    },
    {
      "name": "user/*.read",
      "description": "Read FHIR resources for all patients the user is authorized to access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read FHIR data for your authorized patients"
      }
    },
    {
      "name": "user/*.write",
      "description": "Write FHIR resources for all patients the user is authorized to access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "user/*.*",
      "description": "Read and write FHIR resources for all authorized patients",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "system/*.read",
      "description": "Read any FHIR resource on the server (backend services)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "system/*.write",
      "description": "Write any FHIR resource on the server (backend services)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "system/*.*",
      "description": "Full system access (backend services)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "offline_access",
      "description": "Offline access — allows refresh tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Stay signed in"
      }
    },
    {
      "name": "patient/*.rs",
      "description": "Read and search all FHIR resources for the patient in context (SMART v2 wildcard)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your clinical records"
      }
    },
    { "name": "patient/Patient.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/AllergyIntolerance.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/CarePlan.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/CareTeam.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Condition.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Coverage.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Device.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/DiagnosticReport.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/DocumentReference.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Encounter.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Endpoint.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Goal.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Immunization.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Location.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Media.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Medication.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/MedicationDispense.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/MedicationRequest.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Observation.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Organization.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Practitioner.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/PractitionerRole.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Procedure.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Provenance.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/QuestionnaireResponse.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/RelatedPerson.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/ServiceRequest.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "patient/Specimen.rs", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } }
  ],
  "clients": [
    {
      "clientId": "flint-app",
      "name": "SMART App Client (Public / PKCE)",
      "description": "Public client for browser-based SMART on FHIR applications. Requires PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "http://localhost:8080/*",
        "http://localhost:4567/*",
        "http://localhost:8081/*",
        "http://host.docker.internal/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "fhirUser",
        "offline_access",
        "launch/patient",
        "launch/encounter",
        "patient/*.read",
        "patient/*.write",
        "patient/*.rs",
        "user/*.read",
        "user/*.write",
        "patient/Patient.rs",
        "patient/AllergyIntolerance.rs",
        "patient/CarePlan.rs",
        "patient/CareTeam.rs",
        "patient/Condition.rs",
        "patient/Coverage.rs",
        "patient/Device.rs",
        "patient/DiagnosticReport.rs",
        "patient/DocumentReference.rs",
        "patient/Encounter.rs",
        "patient/Endpoint.rs",
        "patient/Goal.rs",
        "patient/Immunization.rs",
        "patient/Location.rs",
        "patient/Media.rs",
        "patient/Medication.rs",
        "patient/MedicationDispense.rs",
        "patient/MedicationRequest.rs",
        "patient/Observation.rs",
        "patient/Organization.rs",
        "patient/Practitioner.rs",
        "patient/PractitionerRole.rs",
        "patient/Procedure.rs",
        "patient/Provenance.rs",
        "patient/QuestionnaireResponse.rs",
        "patient/RelatedPerson.rs",
        "patient/ServiceRequest.rs",
        "patient/Specimen.rs"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "fhirUser",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "fhirUser",
            "claim.name": "fhirUser",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "patient",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "patient_id",
            "claim.name": "patient",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "flint-backend",
      "name": "Flint Backend Service (Confidential)",
      "description": "Confidential client for server-to-server SMART backend services (client_credentials).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "flint-backend-secret-change-in-prod",
      "defaultClientScopes": [
        "openid"
      ],
      "optionalClientScopes": [
        "system/*.read",
        "system/*.write",
        "system/*.*"
      ]
    }
  ],
