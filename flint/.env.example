# .env.example — Local development
# Copy to .env and fill in your values.
# Never commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=flint
POSTGRES_USER=flint
POSTGRES_PASSWORD=flint_dev_password

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production
ENABLE_AUTH=false

# API key required on X-API-Key header for /admin/* and /ai/* endpoints.
# Leave empty to disable (dev only). Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Per-client requests/minute (identified by X-API-Key header or remote IP).
# Set to 0 to disable application-level rate limiting (nginx IP-level limits still apply).
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AI_PER_MINUTE=20

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Infrastructure ────────────────────────────────────────────────────────────
# These default to the Docker Compose service names — only override if your
# topology differs (e.g. external Elasticsearch cluster or Redis instance).
ELASTICSEARCH_URL=http://elasticsearch:9200
REDIS_URL=redis://redis:6379
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose: anthropic | openai | gemini
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ── SMART on FHIR / Authentication ───────────────────────────────────────────
# ENABLE_AUTH=false — no auth (default; demo-safe)
# ENABLE_AUTH=true  — enforce Bearer tokens on all FHIR requests
#
# Built-in JWT mode (no Keycloak needed):
#   Set AUTH_USERNAME + AUTH_PASSWORD; obtain tokens from POST /auth/token
#
# OIDC mode (Keycloak / Auth0 / Azure AD — recommended for SMART):
#   Set OIDC_ISSUER_URL and start Keycloak: docker compose --profile smart up -d
#   Tokens must come from the external OIDC provider.
#
ENABLE_AUTH=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_TOKEN_EXPIRE_MINUTES=60
OIDC_ISSUER_URL=http://keycloak:8080/realms/fhir
# Browser-facing Keycloak URL. With nginx Keycloak proxy enabled, use port 80 (no :8080).
# This ensures cookies work on 'localhost' and Inferno Docker can reach it via extra_hosts.
OIDC_PUBLIC_ISSUER_URL=http://localhost/realms/fhir
JWKS_CACHE_TTL_SECONDS=3600

# Keycloak admin password (used only when --profile smart is active)
KEYCLOAK_ADMIN_PASSWORD=admin

# Public base URL (used in SMART discovery document; set to your domain in prod)
BASE_URL=http://localhost

# ── External Code Systems ─────────────────────────────────────────────────────
# VSAC/UMLS: free account at https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=

# LOINC: legacy — NLM ClinicalTables is now the default (no credentials needed)
LOINC_USERNAME=
LOINC_PASSWORD=
